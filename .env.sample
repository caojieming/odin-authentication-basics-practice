# .env

# don't forget to run process.loadEnvFile() in app.js to load this file!

PORT=8080

HOST=
USER=
DATABASE=
PASSWORD=
DBPORT=5432


# general template/structure: postgresql://{USER}:{PASSWORD}@{HOST}:{DBPORT}/{DATABASE}
LOCAL_DB_URL=''


# search for Node.js version of DB connection from your DB service of choice, and paste the link into the single quotes
# I don't know about other services, but for Neon, you also need to add this to the end of your URL: &sslmode=verify-full
SERVER_DB_URL=''
