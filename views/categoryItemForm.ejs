<html>
  <head>
    <!-- set styling file -->
    <link rel="stylesheet" href="/css/base.css">
    <title>Add Item to Category</title>
  </head>
  <body>
    <main>
      <a href="/category/<%= category_name %>"><button>Back to Category</button></a>

      <h1>Add Item to <%= category_name %>!</h1>

      <%- include("partials/errors.ejs") %>
      
      <!-- add a dropdown list to select from existing items that aren't already in the active category -->
      <p>Available items to add:</p>

      <form method="POST" action="/category/<%= category_name %>/categoryItemForm">

        <select name="categoryItem" id="categoryItem">
          <option value="invalidOption">[Select an option below]</option>
          <% for (let i = 0; i < items.length; i++) { 
            curItem = items[i]; %>
            <option value="<%= curItem.name %>"><%= curItem.name %></option>
          <% } %>
        </select>

        <button>Submit</button>
      </form>
    </main>
    
    <%- include('./partials/footer') %>
  </body>
</html>