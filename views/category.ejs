<html>
  <head>
    <!-- set styling file -->
    <link rel="stylesheet" href="/css/base.css">
    <title>Category - <%= category.name %></title>
  </head>
  <body>
    <main>
      <a href="/"><button>Back to Home</button></a>

      <h1><%= category.name %></h1>

      <form method="POST" action="/editCategory/<%= category.name %>">
        <label for="description">Description:</label>
        <input name="description" type="text" placeholder="input description here" value="<%= category.description %>">
        <br><br>
        <button>Change category details!</button>
      </form>

      <div id="section-items">
        <a href="/category/<%= category.name %>/categoryItemForm"><button>Add an existing item to <%= category.name %></button></a>

        <a href="/category/<%= category.name %>/itemForm"><button>Create a new item and add it to <%= category.name %></button></a>

        <div class="list">
          <% for (let i = 0; i < items.length; i++) { 
            curItem = items[i]; %>
            <div class="item">
              <form method="POST" action="/deleteCategoryItem/<%= category.name %>/<%= curItem.item_name %>">
                <button class="delete-btn">Remove</button>
              </form>

              <a href="/category/<%= category.name %>/item/<%= curItem.item_name %>" ><button class="item-btn"><%= curItem.item_name %></button></a>
              <p><%= `Stock: ${curItem.stock}` %></p>
              <p><%= `Description: ${curItem.description}` %></p>
            </div>
          <% } %>
        </div>
      </div>
    </main>
    
    <%- include('./partials/footer') %>
  </body>
</html>